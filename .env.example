# --- Telegram ---
BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOTFATHER_TOKEN

# --- Database ---
# Async SQLAlchemy URL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://city_tycoon:city_tycoon@localhost:5432/city_tycoon

# --- Redis (used from Phase 2 onward for rate limiting / caching) ---
REDIS_URL=redis://localhost:6379/0

# --- Mini App ---
# Public HTTPS URL where the Mini App frontend is served (required by Telegram,
# see Phase 3). Leave empty during local Phase 1/2 development.
WEBAPP_URL=

# --- Security ---
# Used to validate Telegram WebApp initData (Phase 3+) and for any signing needs.
SECRET_KEY=replace-with-a-long-random-string

# --- Environment ---
# One of: development | production
ENVIRONMENT=development
LOG_LEVEL=INFO
